{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/agent-tracker hook start --agent codex",
            "async": false,
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/agent-tracker hook end --agent codex",
            "async": false,
            "timeout": 5
          }
        ]
      }
    ]
  }
}
